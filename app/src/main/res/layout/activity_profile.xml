<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/lightBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primaryBlue"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, Student"
            android:textSize="16sp"
            android:textColor="@color/textGray"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/textGray"
            app:cardBackgroundColor="@color/cardBackground"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- View Mode Layout -->
                <LinearLayout
                    android:id="@+id/layoutProfileView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textSize="12sp"
                        android:textColor="@color/textGray" />
                    <TextView
                        android:id="@+id/tvDispFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="18sp"
                        android:textColor="@color/textDark"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Address"
                        android:textSize="12sp"
                        android:textColor="@color/textGray" />
                    <TextView
                        android:id="@+id/tvDispEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="18sp"
                        android:textColor="@color/textDark"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Roll Number"
                        android:textSize="12sp"
                        android:textColor="@color/textGray" />
                    <TextView
                        android:id="@+id/tvDispRollNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="18sp"
                        android:textColor="@color/textDark"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Branch"
                        android:textSize="12sp"
                        android:textColor="@color/textGray" />
                    <TextView
                        android:id="@+id/tvDispBranch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="18sp"
                        android:textColor="@color/textDark"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current CGPA"
                        android:textSize="12sp"
                        android:textColor="@color/textGray" />
                    <TextView
                        android:id="@+id/tvDispCgpa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/accentGreen" />

                    <TextView
                        android:id="@+id/tvCgpaReqStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No pending requests"
                        android:textSize="11sp"
                        android:textColor="@color/primaryBlue"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Technical Skills"
                        android:textSize="12sp"
                        android:textColor="@color/textGray" />
                    <TextView
                        android:id="@+id/tvDispTechStack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="18sp"
                        android:textColor="@color/textDark"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resume / CV"
                        android:textSize="12sp"
                        android:textColor="@color/textGray" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewResume"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="View Resume"
                        android:textColor="@color/primaryBlue"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnableEdit"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="EDIT PROFILE"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        android:elevation="4dp"
                        android:backgroundTint="@color/primaryBlue" />
                </LinearLayout>

                <!-- Edit Mode Layout (Initially Hidden) -->
                <LinearLayout
                    android:id="@+id/layoutProfileEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edFullName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/textDark" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Roll Number"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edRollNo"
                            android:textColor="@color/textDark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Branch / Degree"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">
                        <Spinner
                            android:id="@+id/spinnerBranch"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:background="@android:drawable/btn_dropdown" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tech Stack / Skills"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edTechStack"
                            android:textColor="@color/textDark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvRequestCgpaPopup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap to request CGPA update"
                        android:textColor="@color/primaryBlue"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadResume"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="Upload Resume (PDF)"
                        android:layout_marginBottom="16dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="SAVE CHANGES"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        android:elevation="4dp"
                        android:backgroundTint="@color/accentGreen"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelEdit"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="CANCEL"
                        android:textColor="@color/textGray" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoCompanies"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Explore Companies"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:elevation="4dp"
            android:backgroundTint="@color/primaryBlue"
            android:layout_marginBottom="12dp"
            app:icon="@android:drawable/ic_menu_search" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoApplications"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="My Applications"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:elevation="4dp"
            android:backgroundTint="@color/primaryBlue"
            android:layout_marginBottom="16dp"
            app:icon="@android:drawable/ic_menu_agenda" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStudentChangePass"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Password"
            android:textColor="@color/primaryBlue"
            android:layout_gravity="center_horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeToggle"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙 Dark Mode"
            android:textColor="@color/textGray"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="LOGOUT"
            android:textColor="#D32F2F"
            app:strokeColor="#D32F2F"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>
